{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/_blob/:id", "destination": "https://vqttmptwixcevmgzeeon.supabase.co/storage/v1/object/public/media/:id" },
    { "source": "/((?!api/|_blob/|icons/|manifest.webmanifest|config.js|claude-shim.js).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/claude-shim.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/config.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
